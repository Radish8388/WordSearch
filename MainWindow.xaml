<Window x:Class="Word_Search.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Word_Search"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered"
        SizeChanged="Window_SizeChanged"
        Deactivated="Window_Deactivated"
        Activated="Window_Activated"
        Title="Word Search"
        Height="800" Width="1000">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_New Puzzle">
                <MenuItem Header="Small" Click="Size8_Click">
                </MenuItem>
                <MenuItem Header="Medium" Click="Size12_Click">
                </MenuItem>
                <MenuItem Header="Large" Click="Size16_Click">
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="PauseMenuItem" Header="_Pause" Click="Pause_Click"/>
            <MenuItem Header="_Scores" Click="Scores_Click"/>
        </Menu>

        <StackPanel DockPanel.Dock="Top"  Orientation="Horizontal" HorizontalAlignment="Center" Height="30">
            <TextBlock x:Name="Time" Text="Time : 00:00" FontSize="24" Margin="0,0,50,0"/>
            <TextBlock x:Name="Score" Text="Score : 0" FontSize="24" Margin="0,0,0,0"/>
        </StackPanel>

        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Canvas x:Name="canvas1" Background="White" Grid.Column="0"
                    SizeChanged="canvas1_SizeChanged"
                    PreviewMouseDown="canvas1_PreviewMouseDown"
                    PreviewMouseMove="canvas1_PreviewMouseMove"
                    PreviewMouseUp="canvas1_PreviewMouseUp"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Button Content="↑" Grid.Row="0" FontSize="30" FontWeight="Bold" Click="Up_Click"/>
                <Button Content="↓" Grid.Row="2" FontSize="30" FontWeight="Bold"  Click="Down_Click"/>
                <Canvas x:Name="canvas2" Background="White" Grid.Row="1"
                    SizeChanged="canvas2_SizeChanged"
                    PreviewMouseDown="canvas2_PreviewMouseDown"/>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
